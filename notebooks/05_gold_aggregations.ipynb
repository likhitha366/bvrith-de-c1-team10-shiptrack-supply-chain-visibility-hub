```json
{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 05 — Gold Aggregations\n",
        "\n",
        "**Week:** 7\n",
        "\n",
        "**Project:** ShipTrack\n",
        "\n",
        "**Goal:** Create dashboard-ready Gold metric tables from the Trusted Silver shipment data.\n",
        "\n",
        "The Gold layer provides shipment, delivery, carrier, hub, zone, delay and severity metrics for analytics and dashboards.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Gold shipment summary by date and status\n",
        "CREATE OR REPLACE TABLE gold_shipment_summary_by_date AS\n",
        "SELECT\n",
        "  DATE(event_timestamp) AS event_date,\n",
        "  status,\n",
        "  COUNT(*) AS record_count,\n",
        "  COUNT(DISTINCT shipment_id) AS unique_shipments\n",
        "FROM silver_shipments\n",
        "GROUP BY DATE(event_timestamp), status;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_shipment_summary_by_date\n",
        "ORDER BY event_date, status;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Carrier performance metrics\n",
        "CREATE OR REPLACE TABLE gold_carrier_performance AS\n",
        "SELECT\n",
        "  carrier_id,\n",
        "  COUNT(DISTINCT shipment_id) AS total_shipments,\n",
        "  SUM(CASE WHEN status = 'Delivered' THEN 1 ELSE 0 END) AS delivered_shipments,\n",
        "  SUM(CASE WHEN status = 'Delayed' THEN 1 ELSE 0 END) AS delayed_shipments,\n",
        "  SUM(CASE WHEN severity IN ('HIGH', 'CRITICAL') THEN 1 ELSE 0 END) AS high_risk_events\n",
        "FROM silver_shipments\n",
        "GROUP BY carrier_id;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_carrier_performance\n",
        "ORDER BY total_shipments DESC;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Hub performance metrics\n",
        "CREATE OR REPLACE TABLE gold_hub_performance AS\n",
        "SELECT\n",
        "  hub_id,\n",
        "  COUNT(DISTINCT shipment_id) AS total_shipments,\n",
        "  SUM(CASE WHEN status = 'Delivered' THEN 1 ELSE 0 END) AS delivered_shipments,\n",
        "  SUM(CASE WHEN status = 'Delayed' THEN 1 ELSE 0 END) AS delayed_shipments,\n",
        "  SUM(CASE WHEN status = 'Exception' THEN 1 ELSE 0 END) AS exception_shipments\n",
        "FROM silver_shipments\n",
        "GROUP BY hub_id;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_hub_performance\n",
        "ORDER BY total_shipments DESC;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Zone performance metrics\n",
        "CREATE OR REPLACE TABLE gold_zone_performance AS\n",
        "SELECT\n",
        "  zone_id,\n",
        "  COUNT(DISTINCT shipment_id) AS total_shipments,\n",
        "  SUM(CASE WHEN status = 'Delivered' THEN 1 ELSE 0 END) AS delivered_shipments,\n",
        "  SUM(CASE WHEN status = 'Delayed' THEN 1 ELSE 0 END) AS delayed_shipments,\n",
        "  SUM(CASE WHEN severity IN ('HIGH', 'CRITICAL') THEN 1 ELSE 0 END) AS high_risk_shipments\n",
        "FROM silver_shipments\n",
        "GROUP BY zone_id;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_zone_performance\n",
        "ORDER BY total_shipments DESC;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Delivery status summary\n",
        "CREATE OR REPLACE TABLE gold_delivery_status_summary AS\n",
        "SELECT\n",
        "  status,\n",
        "  COUNT(DISTINCT shipment_id) AS shipment_count,\n",
        "  ROUND(\n",
        "    COUNT(DISTINCT shipment_id) * 100.0 /\n",
        "    SUM(COUNT(DISTINCT shipment_id)) OVER (),\n",
        "    2\n",
        "  ) AS percentage_of_shipments\n",
        "FROM silver_shipments\n",
        "GROUP BY status;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_delivery_status_summary\n",
        "ORDER BY shipment_count DESC;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Delay analysis by carrier, hub and zone\n",
        "CREATE OR REPLACE TABLE gold_delay_analysis AS\n",
        "SELECT\n",
        "  carrier_id,\n",
        "  hub_id,\n",
        "  zone_id,\n",
        "  COUNT(DISTINCT shipment_id) AS total_shipments,\n",
        "  COUNT(DISTINCT CASE WHEN status = 'Delayed' THEN shipment_id END) AS delayed_shipments,\n",
        "  ROUND(\n",
        "    COUNT(DISTINCT CASE WHEN status = 'Delayed' THEN shipment_id END) * 100.0 /\n",
        "    NULLIF(COUNT(DISTINCT shipment_id), 0),\n",
        "    2\n",
        "  ) AS delay_percentage\n",
        "FROM silver_shipments\n",
        "GROUP BY carrier_id, hub_id, zone_id;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_delay_analysis\n",
        "ORDER BY delay_percentage DESC;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Shipment severity summary\n",
        "CREATE OR REPLACE TABLE gold_severity_summary AS\n",
        "SELECT\n",
        "  severity,\n",
        "  COUNT(*) AS event_count,\n",
        "  COUNT(DISTINCT shipment_id) AS affected_shipments\n",
        "FROM silver_shipments\n",
        "GROUP BY severity;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_severity_summary\n",
        "ORDER BY event_count DESC;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Main ShipTrack KPI table\n",
        "CREATE OR REPLACE TABLE gold_shiptrack_kpis AS\n",
        "SELECT\n",
        "  COUNT(DISTINCT shipment_id) AS total_shipments,\n",
        "  COUNT(DISTINCT CASE WHEN status = 'Delivered' THEN shipment_id END) AS delivered_shipments,\n",
        "  COUNT(DISTINCT CASE WHEN status = 'Delayed' THEN shipment_id END) AS delayed_shipments,\n",
        "  COUNT(DISTINCT CASE WHEN status = 'Exception' THEN shipment_id END) AS exception_shipments,\n",
        "  COUNT(DISTINCT CASE WHEN severity IN ('HIGH', 'CRITICAL') THEN shipment_id END) AS high_risk_shipments\n",
        "FROM silver_shipments;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "SELECT *\n",
        "FROM gold_shiptrack_kpis;\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%sql\n",
        "\n",
        "-- Final KPI calculations\n",
        "SELECT\n",
        "  total_shipments,\n",
        "  delivered_shipments,\n",
        "  delayed_shipments,\n",
        "  exception_shipments,\n",
        "  high_risk_shipments,\n",
        "  ROUND(\n",
        "    delivered_shipments * 100.0 /\n",
        "    NULLIF(total_shipments, 0),\n",
        "    2\n",
        "  ) AS delivery_rate_percentage,\n",
        "  ROUND(\n",
        "    delayed_shipments * 100.0 /\n",
        "    NULLIF(total_shipments, 0),\n",
        "    2\n",
        "  ) AS delay_rate_percentage\n",
        "FROM gold_shiptrack_kpis;\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Gold Metrics Definition\n",
        "\n",
        "### Total Shipments\n",
        "COUNT(DISTINCT shipment_id)\n",
        "\n",
        "### Delivered Shipments\n",
        "COUNT(DISTINCT shipment_id) where status = 'Delivered'\n",
        "\n",
        "### Delayed Shipments\n",
        "COUNT(DISTINCT shipment_id) where status = 'Delayed'\n",
        "\n",
        "### Delivery Rate\n",
        "Delivered Shipments / Total Shipments × 100\n",
        "\n",
        "### Delay Rate\n",
        "Delayed Shipments / Total Shipments × 100\n",
        "\n",
        "### Exception Shipments\n",
        "COUNT(DISTINCT shipment_id) where status = 'Exception'\n",
        "\n",
        "### High-Risk Shipments\n",
        "COUNT(DISTINCT shipment_id) where severity is HIGH or CRITICAL\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Update\n",
        "\n",
        "Gold tables created for dashboard-ready ShipTrack analytics.\n",
        "\n",
        "Tables created:\n",
        "- gold_shipment_summary_by_date\n",
        "- gold_carrier_performance\n",
        "- gold_hub_performance\n",
        "- gold_zone_performance\n",
        "- gold_delivery_status_summary\n",
        "- gold_delay_analysis\n",
        "- gold_severity_summary\n",
        "- gold_shiptrack_kpis\n"
      ]
    }
