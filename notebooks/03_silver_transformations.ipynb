# 11. DATA TYPE / RANGE CHECKS
# ============================================================

print("")
print("============================================================")
print("NUMERIC QUALITY CHECKS")
print("============================================================")

invalid_shipments = (
    spark.table("silver_shipments")
    .filter(
        (F.col("package_weight_kg") < 0)
        | (F.col("package_count") < 0)
        | (F.col("freight_amount_inr") < 0)
        | (F.col("attempt_count") < 0)
    )
    .count()
)

invalid_routes = (
    spark.table("silver_routes")
    .filter(
        (F.col("distance_km") < 0)
        | (F.col("expected_transit_hours") < 0)
    )
    .count()
)

invalid_scan_sequences = (
    spark.table("silver_scan_events")
    .filter(F.col("event_sequence_no") <= 0)
    .count()
)

print(
    "Invalid shipment numeric rows :",
    invalid_shipments
)

print(
    "Invalid route numeric rows    :",
    invalid_routes
)

print(
    "Invalid scan sequence rows    :",
