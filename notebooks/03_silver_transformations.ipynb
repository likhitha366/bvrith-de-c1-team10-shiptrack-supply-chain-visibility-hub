# ============================================================
# SHIPTRACK SUPPLY CHAIN VISIBILITY HUB
# 03 - SILVER TRANSFORMATIONS
# WEEK 5
# ============================================================
#
# Bronze Tables -> Clean / Standardize -> Silver Tables
#
# Creates:
#   1. silver_scan_events
#   2. silver_shipments
#   3. silver_carriers
#   4. silver_routes
#   5. silver_hubs
#   6. silver_exceptions
#
# ============================================================

from pyspark.sql import functions as F


# ============================================================
# 1. LOAD BRONZE TABLES
# ============================================================

bronze_scan_events = spark.table("bronze_scan_events")
bronze_shipments = spark.table("bronze_shipments")
bronze_carriers = spark.table("bronze_carriers")
bronze_routes = spark.table("bronze_routes")
bronze_hubs = spark.table("bronze_hubs")
bronze_exceptions = spark.table("bronze_exceptions")

print("============================================================")
print("BRONZE TABLE COUNTS")
print("============================================================")

print("bronze_scan_events :", bronze_scan_events.count())
print("bronze_shipments   :", bronze_shipments.count())
print("bronze_carriers    :", bronze_carriers.count())
print("bronze_routes      :", bronze_routes.count())
print("bronze_hubs        :", bronze_hubs.count())
print("bronze_exceptions  :", bronze_exceptions.count())


# ============================================================
# 2. SILVER - SCAN EVENTS
# ============================================================
#
# Actual Bronze columns:
# source_record_id
# scan_id
# shipment_id
# event_sequence_no
# event_type
# shipment_status
# event_time
# hub_id
# carrier_id
# route_id
# exception_type
# package_condition
# status_reason
# source_system
# run_id
# ingestion_timestamp
# source_file_name
# batch_id
#
# ============================================================

silver_scan_events = (
    bronze_scan_events

    # Remove completely duplicated records
    .dropDuplicates()

    # Standardize text fields
    .withColumn("source_record_id", F.trim(F.col("source_record_id")))
    .withColumn("scan_id", F.trim(F.col("scan_id")))
    .withColumn("shipment_id", F.trim(F.col("shipment_id")))
    .withColumn("event_type", F.upper(F.trim(F.col("event_type"))))
    .withColumn("shipment_status", F.lower(F.trim(F.col("shipment_status"))))
    .withColumn("hub_id", F.trim(F.col("hub_id")))
    .withColumn("carrier_id", F.trim(F.col("carrier_id")))
    .withColumn("route_id", F.trim(F.col("route_id")))
    .withColumn("exception_type", F.trim(F.col("exception_type")))
    .withColumn("package_condition", F.trim(F.col("package_condition")))
    .withColumn("status_reason", F.trim(F.col("status_reason")))
    .withColumn("source_system", F.trim(F.col("source_system")))
    .withColumn("run_id", F.trim(F.col("run_id")))
    .withColumn("source_file_name", F.trim(F.col("source_file_name")))
    .withColumn("batch_id", F.trim(F.col("batch_id")))

    # Standardize numeric / timestamp fields
    .withColumn(
        "event_sequence_no",
        F.col("event_sequence_no").cast("long")
    )
    .withColumn(
        "event_time",
        F.to_timestamp(F.col("event_time"))
    )
    .withColumn(
        "ingestion_timestamp",
        F.to_timestamp(F.col("ingestion_timestamp"))
    )

    # Create event date for analysis
    .withColumn(
        "event_date",
        F.to_date(F.col("event_time"))
    )
)

# Save
silver_scan_events.write.mode("overwrite").saveAsTable(
    "silver_scan_events"
)

print("============================================================")
print("SILVER SCAN EVENTS")
print("============================================================")
print(
    "Rows:",
    spark.table("silver_scan_events").count()
)

display(
    spark.table("silver_scan_events").limit(10)
)


