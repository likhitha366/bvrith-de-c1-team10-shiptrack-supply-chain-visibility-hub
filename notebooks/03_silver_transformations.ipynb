    )
    .withColumn(
        "destination_hub_id",
        F.trim(F.col("destination_hub_id"))
    )
    .withColumn(
        "carrier_id",
        F.trim(F.col("carrier_id"))
    )
    .withColumn(
        "service_level",
        F.upper(F.trim(F.col("service_level")))
    )
    .withColumn(
        "transport_mode",
        F.upper(F.trim(F.col("transport_mode")))
    )
    .withColumn(
        "latest_status",
        F.upper(F.trim(F.col("latest_status")))
    )
    .withColumn(
        "delivery_outcome",
        F.upper(F.trim(F.col("delivery_outcome")))
    )
    .withColumn(
        "status_reason",
        F.trim(F.col("status_reason"))
    )

    # Standardize timestamps
    .withColumn(
        "booking_ts",
        F.to_timestamp(F.col("booking_ts"))
    )
    .withColumn(
        "pickup_ts",
        F.to_timestamp(F.col("pickup_ts"))
    )
    .withColumn(
        "promised_delivery_ts",
        F.to_timestamp(F.col("promised_delivery_ts"))
    )
    .withColumn(
        "actual_delivery_ts",
        F.to_timestamp(F.col("actual_delivery_ts"))
    )
    .withColumn(
        "return_completed_ts",
        F.to_timestamp(F.col("return_completed_ts"))
    )
    .withColumn(
        "ingestion_timestamp",
        F.to_timestamp(F.col("ingestion_timestamp"))
    )

    # Standardize numeric fields
    .withColumn(
        "package_weight_kg",
        F.col("package_weight_kg").cast("double")
    )
    .withColumn(
        "package_count",
        F.col("package_count").cast("long")
    )
    .withColumn(
        "freight_amount_inr",
        F.col("freight_amount_inr").cast("double")
    )
    .withColumn(
        "attempt_count",
        F.col("attempt_count").cast("long")
    )

    # Standardize boolean
    .withColumn(
        "exception_flag",
        F.col("exception_flag").cast("boolean")
    )

    # Metadata
    .withColumn(
        "source_system",
        F.trim(F.col("source_system"))
    )
    .withColumn(
        "run_id",
        F.trim(F.col("run_id"))
    )
    .withColumn(
        "source_file_name",
        F.trim(F.col("source_file_name"))
    )
    .withColumn(
        "batch_id",
        F.trim(F.col("batch_id"))
